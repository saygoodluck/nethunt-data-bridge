# ClickHouse
CLICKHOUSE_HOST=
CLICKHOUSE_DATABASE=
CLICKHOUSE_PORT=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# SSH Tunnel
SSH_HOST=
SSH_PORT=
SSH_USER=
# Host-specific: do not carry this value between machines. On the deployment
# server it is the key whose .pub was given to the bastion admins, e.g.
# /root/.ssh/id_ed25519
SSH_KEY_PATH=

# Container deploys have no key file: pass the key itself instead of a path.
# This is checked before SSH_KEY_PATH, and is the simpler option under Docker --
# a mounted key also has to be readable by uid 1000, the `node` user.
#   on the Linux server:  base64 -w0 ~/.ssh/id_ed25519
#   on macOS:             base64 -i ~/.ssh/id_ed25519 | tr -d '\n'
SSH_PRIVATE_KEY_B64=

# Set to 1 when ClickHouse is reachable directly and no bastion is needed
SKIP_SSH_TUNNEL=

# Startup connection retries. The service never exits on a failed connection;
# it serves, reports and keeps retrying.
CONNECT_MIN_TIMEOUT=2000
CONNECT_MAX_TIMEOUT=60000
# Attempts before the chat is told
CONNECT_ALERT_AFTER=5

# NetHunt (v2 REST API)
# Bearer token from Settings -> API & MCP. Looks like nh_live_...
# NOT the key under "Apps and other integrations -> API LEGACY": that one is for
# the old v1 API and is rejected here with 401.
NETHUNT_API_TOKEN=

# Folder holding the synced player records
NETHUNT_FOLDER_ID=
# Service folder holding sync metrics and the last-sync timestamp
NETHUNT_UTILS_FOLDER_ID=
# Override only to point at a mock; defaults to https://nethunt.com/api/v2
NETHUNT_BASE_URL=

# Server
# Bearer token for this service's own /sync endpoint. Unrelated to NetHunt --
# it is the password for triggering a sync by hand.
SYNC_API_KEY=
PORT=3001

# Sync Settings
BATCH_SIZE=100
MAX_CONCURRENT_REQUESTS=5
# Lower bound for the ClickHouse lookback window, in minutes
SYNC_INTERVAL_MINUTES=60

# Redis (NetHunt record id cache)
REDIS_URL=redis://localhost:6379
REDIS_DATABASE=0
CACHE_TTL_SECONDS=1209600 # 14 days

# Telegram (optional -- with no token the bot is simply off)
TELEGRAM_BOT_TOKEN=
# Chat that receives notifications and may issue commands
TELEGRAM_CHAT_ID=
# Extra user ids allowed to run commands, comma separated
TELEGRAM_ADMINS=
# Override only to point at a mock
TELEGRAM_API_BASE=

# 1 = report every single sync. Off by default: 48 a day trains you to ignore the chat
NOTIFY_EACH_SYNC=0
NOTIFY_ERRORS=1
NOTIFY_STARTUP=1
# Daily summary time, HH:MM server time. Empty disables it
DAILY_REPORT_AT=09:00
