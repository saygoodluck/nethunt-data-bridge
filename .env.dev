# Local development contour (docker-compose.dev.yml). No secrets here -- this
# file is committed on purpose so the setup is reproducible.
#
#   npm run dev:up && npm run dev

# ClickHouse runs locally, so no bastion is needed
SKIP_SSH_TUNNEL=1
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=bridge
CLICKHOUSE_PASSWORD=bridge
CLICKHOUSE_DATABASE=analytics

# Point the NetHunt calls at the local mock instead of the real CRM
NETHUNT_BASE_URL=http://127.0.0.1:3010/api/v1/zapier
NETHUNT_USER=dev@example.test
NETHUNT_API_KEY=dev-key
NETHUNT_FOLDER_ID=users
NETHUNT_UTILS_FOLDER_ID=utils

REDIS_URL=redis://127.0.0.1:6379
REDIS_DATABASE=0
CACHE_TTL_SECONDS=1209600

PORT=3001
BATCH_SIZE=100
MAX_CONCURRENT_REQUESTS=5
SYNC_INTERVAL_MINUTES=60
