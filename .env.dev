# Local development contour (docker-compose.dev.yml). No secrets here -- this
# file is committed on purpose so the setup is reproducible.
#
#   npm run dev:up && npm run dev

# ClickHouse runs locally, so no bastion is needed
SKIP_SSH_TUNNEL=1
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=bridge
CLICKHOUSE_PASSWORD=bridge
CLICKHOUSE_DATABASE=analytics

# Point the NetHunt calls at the local mock instead of the real CRM
NETHUNT_BASE_URL=http://127.0.0.1:3010/api/v2
NETHUNT_API_TOKEN=nh_live_devtoken
NETHUNT_FOLDER_ID=users
NETHUNT_UTILS_FOLDER_ID=utils

# Bearer token for this service's own /sync endpoint, unrelated to NetHunt
SYNC_API_KEY=dev-key

REDIS_URL=redis://127.0.0.1:6379
REDIS_DATABASE=0
CACHE_TTL_SECONDS=1209600

PORT=3001
BATCH_SIZE=100
MAX_CONCURRENT_REQUESTS=5
SYNC_INTERVAL_MINUTES=60

# Telegram, pointed at the mock instead of api.telegram.org.
#
# NEVER put a real bot token here: this file is committed. To try the bot
# against a real chat, override on the command line instead -- dotenv does not
# overwrite variables that are already set:
#
#   TELEGRAM_BOT_TOKEN=... TELEGRAM_CHAT_ID=... \
#   TELEGRAM_API_BASE=https://api.telegram.org npm run dev
TELEGRAM_BOT_TOKEN=dev-bot-token
TELEGRAM_CHAT_ID=12345
TELEGRAM_API_BASE=http://127.0.0.1:3010
NOTIFY_ERRORS=1
NOTIFY_STARTUP=1
NOTIFY_EACH_SYNC=0
DAILY_REPORT_AT=09:00
